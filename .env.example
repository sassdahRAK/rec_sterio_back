# recsterio backend environment template (backend-only vars).
# Copy to backend/.env and fill in real values. NEVER commit a filled-in .env.
# The root ../.env is also read as a fallback.

# --- core ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recsterio
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@recsterio.local
ADMIN_PASSWORD=change-me
ACCESS_TOKEN_TTL_MINUTES=720
LOG_LEVEL=INFO

# --- media storage ---
MEDIA_ROOT=./storage/media
# Largest accepted direct upload (POST /videos/upload), in megabytes.
MAX_UPLOAD_MB=512

# --- Telegram (service token used by the bot to call this API) ---
TELEGRAM_BOT_TOKEN=
BOT_API_TOKEN=replace-me-with-a-shared-service-token

# --- Gemini (feature 4: independent transcription + merge) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_AUDIO_CHUNK_SECONDS=600

# --- local ASR (feature 2) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- worker ---
WORKER_POLL_SECONDS=3
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
# Set to false to run the worker separately: python -m app.worker.main
WORKER_AUTOSTART=true
# Reclaim window for a *running* compress_video job, in seconds (default 4 h).
# A delivery transcode of a large source legitimately runs for hours and must
# not be reclaimed as "stale" while it is still working. Every other job kind
# keeps the generic 30 min window. Handlers also refresh the row's started_at
# as they make progress, so this is only the worst-case safety net.
WORKER_COMPRESS_STALE_SECONDS=14400

# --- Google sign-in (instruction.txt #2) ---
# The public OAuth client id only; the browser gets an ID token and the API
# verifies it with Google. Leave empty to hide the button — nothing else breaks.
GOOGLE_CLIENT_ID=
# Where share links point: the public portal.
PORTAL_FRONTEND_URL=http://localhost:5174
# Lifetime of a guest / passcode / share token, in minutes.
GUEST_TTL_MINUTES=1440

# --- browser origins (CORS): the ops console and the public portal ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- rate limits ---
VIDEO_CREATE_RATE_LIMIT=20
VIDEO_CREATE_RATE_WINDOW=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60
# Passcode / share redemption: guesses allowed per client IP and target.
PUBLIC_REDEEM_RATE_LIMIT=15
PUBLIC_REDEEM_RATE_WINDOW=60
# Most recent live passcodes one redemption bcrypt-verifies. Lower it to cut
# the CPU a single wrong guess can burn; raise it only if your folders stack
# more live codes than this and old ones must keep redeeming.
PUBLIC_REDEEM_SCAN_LIMIT=100
# Where the limiter takes the caller's address from.
# False (default): the API faces clients directly — `X-Forwarded-For` from the
# client is ignored, rate-limit keys use the socket peer only.
# True: ONLY when a TLS-terminating proxy on the same host (Caddy in the
# deploy compose) sits in front of uvicorn. The limiter then reads the real
# client from the LAST hop of X-Forwarded-For — the hop the proxy wrote.
# MUST be true in the Caddy deploy: otherwise every visitor looks like the
# proxy's own address and shares one rate-limit bucket.
TRUST_PROXY_HEADERS=false

# --- ffmpeg ---
FFMPEG_TIMEOUT_SECONDS=600

# --- downloader (yt-dlp) ---
# TikTok/YouTube answer server IPs with a bot check. A Netscape-format cookies
# file exported from a browser session you are entitled to use is the supported
# remedy (yt-dlp --cookies-from-browser chrome --cookies ./cookies.txt <url>).
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
YTDLP_USER_AGENT=
# Local dev: read cookies straight from a browser profile instead of a file.
# e.g. chrome, or chrome:Profile 1. Leave empty in Docker (no browser inside).
YTDLP_COOKIES_FROM_BROWSER=
# TLS fingerprint impersonation, e.g. chrome. Requires curl-cffi (in
# requirements.txt). TikTok usually refuses non-browser clients without this.
YTDLP_IMPERSONATE=

# --- per-user bot cookies (POST /bot-users/<telegram_id>/cookies) ---
# Per-user cookies.txt exports live here, one 0600 file per Telegram id.
# Default: ./storage/cookies — set /data/cookies in Docker.
COOKIES_ROOT=
# Largest accepted cookies.txt upload, in kilobytes.
MAX_COOKIES_KB=2048

# --- personal-cloud storage (optional) ---
# A contributor may keep their uploaded video bytes on their own Google Drive
# or OneDrive. Both providers are OFF unless a client id AND secret are set.
# Google reuses GOOGLE_CLIENT_ID above unless DRIVE_GOOGLE_CLIENT_ID is set.
# Register DRIVE_OAUTH_REDIRECT as an "Authorized redirect URI" at the provider.
DRIVE_GOOGLE_CLIENT_ID=
DRIVE_GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=common
DRIVE_OAUTH_REDIRECT=http://localhost:5174/settings
# Required to encrypt drive refresh tokens at rest. Generate once with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Without it, connecting a drive fails 400 cloud_token_key_required — tokens are
# never stored in plaintext unless ALLOW_INSECURE=1.
CLOUD_TOKEN_KEY=
